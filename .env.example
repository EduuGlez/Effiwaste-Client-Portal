# Configuración de ejemplo. No guardes secretos reales en Git.
OPENAI_API_KEY=cambiar
ENVIRONMENT=development

# Modelos configurables. Astra maximiza precisión; Luna reduce el coste del OCR visual.
OPENAI_CHAT_MODEL=gpt-6-astra
OPENAI_VISION_MODEL=gpt-5.6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSIONS=1536

# Cambia estos secretos antes de exponer la aplicación fuera de localhost.
SESSION_SECRET=cambiar
ADMIN_EMAIL=cambiar
ADMIN_PASSWORD=cambiar
DEMO_USER_EMAIL=cambiar
DEMO_USER_PASSWORD=cambiar

POSTGRES_DB=cambiar
POSTGRES_USER=cambiar
POSTGRES_PASSWORD=cambiar
DATABASE_URL=cambiar
REDIS_URL=cambiar
UPLOAD_DIR=cambiar
MAX_UPLOAD_MB=50
MAX_PDF_PAGES=300

# Centro de ayuda. Usa las credenciales SMTP de tu proveedor de correo.
SUPPORT_EMAIL=cambiar
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=cambiar
SMTP_PASSWORD=cambiar
SMTP_FROM_EMAIL=cambiar
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SUPPORT_ATTACHMENT_MAX_MB=10
SUPPORT_ATTACHMENT_MAX_COUNT=5
COOKIE_SECURE=false
SESSION_MAX_AGE_SECONDS=43200
ALLOWED_HOSTS=localhost,127.0.0.1
LOGIN_MAX_ATTEMPTS=8
LOGIN_IP_MAX_ATTEMPTS=40
LOGIN_WINDOW_SECONDS=900
SEED_DEMO_DATA=true
