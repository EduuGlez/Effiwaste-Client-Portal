# Copia este archivo a .env antes de arrancar Docker Compose.
OPENAI_API_KEY=sk-cambia-esto

# Modelos configurables. Astra maximiza precisión; Luna reduce el coste del OCR visual.
OPENAI_CHAT_MODEL=gpt-6-astra
OPENAI_VISION_MODEL=gpt-5.6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSIONS=1536

# Cambia estos secretos antes de exponer la aplicación fuera de localhost.
SESSION_SECRET=cambia-esta-clave-por-una-aleatoria-larga
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin123!
DEMO_USER_EMAIL=usuario@example.com
DEMO_USER_PASSWORD=Usuario123!

POSTGRES_DB=raghotel
POSTGRES_USER=raghotel
POSTGRES_PASSWORD=raghotel
DATABASE_URL=postgresql+psycopg://raghotel:raghotel@db:5432/raghotel
REDIS_URL=redis://redis:6379/0
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_MB=50
MAX_PDF_PAGES=300
COOKIE_SECURE=false
